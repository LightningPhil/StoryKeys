{
  "name": "storykeys",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "description": "A calm, dyslexia-friendly typing tutor for young learners.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tools/ts-loader.mjs --test tests/domain.test.ts",
    "check:data": "node tools/validate-data.mjs",
    "check:contrast": "node tools/contrast.mjs",
    "check": "npm run check:data && npm run check:contrast && npm test",
    "check:smoke": "node tools/smoke.mjs",
    "shots": "node tools/screenshot.mjs shots"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "jspdf": "^4.2.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
